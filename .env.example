# Browser → API. Leave unset locally to use the same-origin Vite proxy.
# VITE_API_URL=https://api.example.com
SITE_URL=http://localhost:3000

# Local API
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
UPLOAD_DIRECTORY=data/uploads

# Swappable local-first adapters. Future AWS implementations register here.
WORKSPACE_REPOSITORY=local-json
KNOWLEDGE_REPOSITORY=local-filesystem
AI_PROVIDER=openai
# Code sandbox execution: "e2b" (default, cloud microVMs with pre-installed Python, Java, C++, DuckDB) or "local"
SANDBOX_EXECUTOR=e2b
# E2B credentials can be added to keys/key.txt


# Optional: server-side Unsplash search for custom course banner images.
# Create an application: https://unsplash.com/developers
# Photo search API: https://unsplash.com/documentation#search-photos
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# OpenAI credentials are loaded from this local, git-ignored file.
OPENAI_KEY_FILE=keys/key.txt
OPENAI_MODEL=gpt-5-nano
OPENAI_RESEARCH_MODEL=gpt-5.4-nano
OPENAI_TEACHER_MODEL=gpt-5.4-nano
OPENAI_ASSESSOR_MODEL=gpt-5.4-nano

# Cognito hosted login (optional locally; guests work without these).
# Use the stack's CognitoDomain, UserPoolClientId, and UserPoolId outputs.
# COGNITO_DOMAIN=https://your-prefix.auth.us-west-2.amazoncognito.com
# COGNITO_CLIENT_ID=your-web-client-id
# COGNITO_USER_POOL_ID=us-west-2_example
# SITE_URL must exactly match the browser origin and registered callback URL.
# Local default: http://localhost:3000 (5173 is also registered in CDK).

# AWS runtime: CDK supplies these; do not put AWS credentials in VITE_* variables.
# SESSION_TABLE=your-session-table
# UPLOADS_BUCKET=your-upload-bucket
# AUTH_CONFIG_PARAMETER=/adaptlearn/AdaptLearnStack/auth
# WORKSPACE_TABLE=your-workspace-table
# WORKSPACE_REPOSITORY=dynamodb
# KNOWLEDGE_REPOSITORY=s3
